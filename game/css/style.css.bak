/* ============================================================
   GPLab — стили игры
   Структура: переменные -> база -> меню -> игра -> магазин -> навыки
   ============================================================ */

/* ---------- Переменные ---------- */
:root {
  --bg-0: #05070f;
  --bg-1: #0a0f1e;
  --bg-2: #111a33;
  --panel: rgba(16, 24, 45, 0.82);
  --panel-solid: #101828;
  --border: rgba(120, 160, 255, 0.18);
  --border-strong: rgba(120, 160, 255, 0.42);

  --text: #e8eefc;
  --text-dim: #8fa0c4;
  --text-mute: #5b6b8c;

  --accent: #4f8cff;
  --accent-2: #7c5cff;
  --accent-glow: rgba(79, 140, 255, 0.45);

  --gold: #ffc857;
  --gold-glow: rgba(255, 200, 87, 0.4);
  --danger: #ff5c72;
  --danger-glow: rgba(255, 92, 114, 0.4);
  --success: #4ade80;

  --radius: 14px;
  --radius-sm: 9px;
  --radius-lg: 22px;

  --shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
  --shadow-sm: 0 6px 18px rgba(0, 0, 0, 0.35);

  --font: "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
  --mono: "JetBrains Mono", "Consolas", monospace;

  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

/* ---------- База ---------- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  height: 100%;
  overflow: hidden;
}

body {
  font-family: var(--font);
  color: var(--text);
  background: var(--bg-0);
  -webkit-font-smoothing: antialiased;
  user-select: none;
}

#app {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* Фоновая сетка + свечение */
#app::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 15%, rgba(79, 140, 255, 0.16), transparent 45%),
    radial-gradient(circle at 82% 78%, rgba(124, 92, 255, 0.14), transparent 48%),
    radial-gradient(circle at 50% 50%, var(--bg-1), var(--bg-0) 78%);
  z-index: 0;
}

#app::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(120, 160, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(120, 160, 255, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 78%);
  -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 78%);
  z-index: 0;
  pointer-events: none;
}

/* ---------- Экраны ---------- */
.screen {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.screen.active {
  display: flex;
  animation: screenIn 0.42s var(--ease) both;
}

@keyframes screenIn {
  from { opacity: 0; transform: translateY(14px) scale(0.985); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---------- Главное меню ---------- */
.menu-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 34px;
  width: min(560px, 92vw);
}

.logo-block {
  text-align: center;
  position: relative;
}

.logo-title {
  font-size: clamp(46px, 9vw, 84px);
  font-weight: 900;
  letter-spacing: 0.06em;
  line-height: 1;
  background: linear-gradient(135deg, #ffffff 0%, var(--accent) 45%, var(--accent-2) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 26px var(--accent-glow));
  animation: logoPulse 4.5s ease-in-out infinite;
}

@keyframes logoPulse {
  0%, 100% { filter: drop-shadow(0 0 22px var(--accent-glow)); }
  50%      { filter: drop-shadow(0 0 40px rgba(124, 92, 255, 0.55)); }
}

.logo-sub {
  margin-top: 10px;
  font-size: 13px;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: var(--text-mute);
}

.menu-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

/* ---------- Кнопки ---------- */
.btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 15px 22px;
  font-family: inherit;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--text);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  overflow: hidden;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transition: transform 0.18s var(--ease), border-color 0.18s, box-shadow 0.18s, background 0.18s;
}

.btn::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.14) 50%, transparent 70%);
  transform: translateX(-120%);
  transition: transform 0.55s var(--ease);
}

.btn:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
  box-shadow: 0 10px 30px rgba(79, 140, 255, 0.22);
}

.btn:hover::before {
  transform: translateX(120%);
}

.btn:active {
  transform: translateY(0) scale(0.985);
}

.btn .ico {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.btn-primary {
  background: linear-gradient(135deg, rgba(79, 140, 255, 0.28), rgba(124, 92, 255, 0.28));
  border-color: rgba(120, 160, 255, 0.55);
  box-shadow: 0 0 0 1px rgba(120, 160, 255, 0.12) inset, 0 12px 34px rgba(79, 140, 255, 0.24);
}

.btn-primary:hover {
  box-shadow: 0 0 0 1px rgba(120, 160, 255, 0.2) inset, 0 16px 42px rgba(79, 140, 255, 0.36);
}

.btn-ghost {
  background: rgba(16, 24, 45, 0.5);
  font-weight: 500;
}

.btn-danger {
  border-color: rgba(255, 92, 114, 0.4);
  color: #ffd7dd;
}

.btn-danger:hover {
  border-color: rgba(255, 92, 114, 0.75);
  box-shadow: 0 10px 30px var(--danger-glow);
}

.btn:disabled {
  opacity: 0.42;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.btn-sm {
  padding: 9px 15px;
  font-size: 13px;
  border-radius: var(--radius-sm);
}

.btn-sm .ico {
  width: 16px;
  height: 16px;
  flex-basis: 16px;
}

/* ---------- Верхняя панель меню ---------- */
.menu-stats {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
}

.stat-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 15px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 999px;
  font-size: 13px;
  color: var(--text-dim);
  backdrop-filter: blur(12px);
}

.stat-chip .ico {
  width: 16px;
  height: 16px;
  stroke: var(--gold);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.stat-chip b {
  color: var(--text);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ---------- Панели (магазин, навыки) ---------- */
.panel-screen {
  width: min(980px, 96vw);
  max-height: 92vh;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: 0.01em;
}

.panel-title .ico {
  width: 26px;
  height: 26px;
  stroke: var(--accent);
  fill: none;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.panel-body {
  flex: 1;
  overflow-y: auto;
  padding: 4px;
  display: grid;
  gap: 14px;
}

.panel-body::-webkit-scrollbar {
  width: 8px;
}

.panel-body::-webkit-scrollbar-thumb {
  background: rgba(120, 160, 255, 0.25);
  border-radius: 99px;
}

.panel-body::-webkit-scrollbar-track {
  background: transparent;
}

/* ---------- Карточки магазина ---------- */
.shop-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 14px;
}

.card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 18px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  backdrop-filter: blur(14px);
  transition: transform 0.2s var(--ease), border-color 0.2s, box-shadow 0.2s;
}

.card:hover {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  box-shadow: var(--shadow-sm);
}

.card-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(79, 140, 255, 0.2), rgba(124, 92, 255, 0.2));
  border: 1px solid var(--border);
}

.card-icon .ico {
  width: 34px;
  height: 34px;
  stroke: var(--accent);
  fill: none;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.card-name {
  font-size: 16px;
  font-weight: 700;
}

.card-desc {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-dim);
  flex: 1;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 4px;
}

.price {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  color: var(--gold);
  font-variant-numeric: tabular-nums;
}

.price .ico {
  width: 16px;
  height: 16px;
  stroke: var(--gold);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.card.owned {
  border-color: rgba(74, 222, 128, 0.4);
}

.card.owned .card-icon {
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.2), rgba(74, 222, 128, 0.1));
}

.card.owned .card-icon .ico {
  stroke: var(--success);
}

.badge-owned {
  position: absolute;
  top: 12px;
  right: 12px;
  padding: 3px 9px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--success);
  background: rgba(74, 222, 128, 0.14);
  border: 1px solid rgba(74, 222, 128, 0.35);
  border-radius: 999px;
}

/* ---------- Дерево навыков ---------- */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
}

.skill-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  backdrop-filter: blur(14px);
  transition: transform 0.2s var(--ease), border-color 0.2s, box-shadow 0.2s;
}

.skill-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  box-shadow: var(--shadow-sm);
}

.skill-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.skill-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: linear-gradient(135deg, rgba(124, 92, 255, 0.22), rgba(79, 140, 255, 0.16));
  border: 1px solid var(--border);
}

.skill-icon .ico {
  width: 30px;
  height: 30px;
  stroke: var(--accent-2);
  fill: none;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.skill-name {
  font-size: 15px;
  font-weight: 700;
}

.skill-lvl {
  font-size: 12px;
  color: var(--text-mute);
  font-variant-numeric: tabular-nums;
}

.skill-desc {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-dim);
}

.skill-bar {
  height: 7px;
  border-radius: 99px;
  background: rgba(120, 160, 255, 0.12);
  overflow: hidden;
}

.skill-bar-fill {
  height: 100%;
  width: 0%;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  box-shadow: 0 0 12px var(--accent-glow);
  transition: width 0.4s var(--ease);
}

.skill-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.skill-max {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--gold);
}

/* ---------- Экран игры ---------- */
#screen-game {
  padding: 0;
  justify-content: flex-start;
}

.hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  padding: 16px 20px;
  pointer-events: none;
}

.hud-left,
.hud-right {
  display: flex;
  align-items: center;
  gap: 10px;
  pointer-events: auto;
}

.hud-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: rgba(10, 15, 30, 0.72);
  border: 1px solid var(--border);
  border-radius: 999px;
  backdrop-filter: blur(12px);
  font-size: 14px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.hud-stat .ico {
  width: 17px;
  height: 17px;
  stroke: var(--accent);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hud-stat.gold .ico { stroke: var(--gold); }
.hud-stat.danger .ico { stroke: var(--danger); }

.hud-btn {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  background: rgba(10, 15, 30, 0.72);
  border: 1px solid var(--border);
  border-radius: 11px;
  cursor: pointer;
  backdrop-filter: blur(12px);
  transition: border-color 0.18s, background 0.18s, transform 0.18s;
}

.hud-btn:hover {
  border-color: var(--border-strong);
  background: rgba(20, 30, 55, 0.85);
  transform: translateY(-1px);
}

.hud-btn .ico {
  width: 19px;
  height: 19px;
  stroke: var(--text-dim);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hud-btn:hover .ico {
  stroke: var(--text);
}

/* Полоса энергии */
.energy-wrap {
  position: absolute;
  left: 20px;
  bottom: 20px;
  z-index: 5;
  width: min(260px, 40vw);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.energy-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-mute);
}

.energy-label .ico {
  width: 14px;
  height: 14px;
  stroke: var(--accent);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.energy-bar {
  height: 9px;
  border-radius: 99px;
  background: rgba(10, 15, 30, 0.8);
  border: 1px solid var(--border);
  overflow: hidden;
}

.energy-fill {
  height: 100%;
  width: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  box-shadow: 0 0 14px var(--accent-glow);
  transition: width 0.12s linear, background 0.3s;
}

.energy-fill.low {
  background: linear-gradient(90deg, var(--danger), #ff8a5c);
  box-shadow: 0 0 14px var(--danger-glow);
}

/* Канвас */
#gameCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 2;
}

/* Оверлеи (пауза, смерть) */
.overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22px;
  padding: 24px;
  background: rgba(5, 7, 15, 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.overlay.active {
  display: flex;
  animation: overlayIn 0.32s var(--ease) both;
}

@keyframes overlayIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.overlay-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  width: min(440px, 92vw);
  padding: 32px 28px;
  background: var(--panel);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  animation: cardRise 0.42s var(--ease) both;
}

@keyframes cardRise {
  from { opacity: 0; transform: translateY(20px) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.overlay-title {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: 0.02em;
  text-align: center;
}

.overlay-title.dead {
  color: var(--danger);
  text-shadow: 0 0 30px var(--danger-glow);
}

.overlay-sub {
  font-size: 14px;
  color: var(--text-dim);
  text-align: center;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 100%;
}

.result-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 14px;
  background: rgba(10, 15, 30, 0.6);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.result-item span {
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-mute);
}

.result-item b {
  font-size: 20px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.overlay-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
}

.new-record {
  padding: 7px 16px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
  background: rgba(255, 200, 87, 0.12);
  border: 1px solid rgba(255, 200, 87, 0.4);
  border-radius: 999px;
  box-shadow: 0 0 24px var(--gold-glow);
  animation: recordPulse 1.6s ease-in-out infinite;
}

@keyframes recordPulse {
  0%, 100% { box-shadow: 0 0 20px var(--gold-glow); }
  50%      { box-shadow: 0 0 36px rgba(255, 200, 87, 0.65); }
}

/* ---------- Тосты ---------- */
#toasts {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: center;
  pointer-events: none;
}

.toast {
  padding: 11px 20px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  background: var(--panel-solid);
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  box-shadow: var(--shadow-sm);
  animation: toastIn 0.3s var(--ease) both;
}

.toast.ok { border-color: rgba(74, 222, 128, 0.5); color: #d6ffe4; }
.toast.err { border-color: rgba(255, 92, 114, 0.5); color: #ffd7dd; }

@keyframes toastIn {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- Адаптив ---------- */
@media (max-width: 640px) {
  .panel-title { font-size: 21px; }
  .hud { padding: 12px; }
  .hud-stat { padding: 7px 11px; font-size: 13px; }
  .energy-wrap { left: 12px; bottom: 12px; }
  .overlay-card { padding: 24px 20px; }
  .overlay-title { font-size: 24px; }
  .result-grid { grid-template-columns: 1fr; }
}

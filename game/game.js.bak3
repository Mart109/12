// GPLab — игровое ядро. Часть 1: состояние, спавн, попадания.
// Типы врагов берутся из js/config.js (CONFIG.enemyTypes, Utils.pickEnemyType).

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let W = canvas.width;
let H = canvas.height;

function resizeCanvas() {
  const rect = canvas.getBoundingClientRect();
  W = canvas.width = Math.floor(rect.width);
  H = canvas.height = Math.floor(rect.height);
}
window.addEventListener('resize', resizeCanvas);

const game = {
  running: false,
  paused: false,
  over: false,
  level: 1,
  score: 0,
  time: 0,
  spawnTimer: 0,
  spawnInterval: 1.1,
  enemies: [],
  enemyBullets: [],
  bonuses: [],
  particles: [],
  player: null,
  keys: {},
  lastFrame: 0,
  combo: 0,
  comboTimer: 0,
  shake: 0
};

// Точка, к которой идёт игрок (мышь или палец). null — не задана.
const pointer = {
  active: false,
  x: 0,
  y: 0
};

function resetField() {
  game.enemies = [];
  game.enemyBullets = [];
  game.bonuses = [];
  game.particles = [];
  game.spawnTimer = 0;
  game.spawnInterval = CONFIG.enemySpawnBase;
  game.level = 1;
  game.score = 0;
  game.time = 0;
  game.combo = 0;
  game.comboTimer = 0;
  game.shake = 0;
  game.over = false;
  game.paused = false;
  pointer.active = false;
}

function makePlayer() {
  return {
    x: W / 2,
    y: H / 2,
    radius: CONFIG.playerRadius,
    speed: CONFIG.playerSpeed,
    vx: 0,
    vy: 0,
    energy: Bonuses.energyMax(),
    maxEnergy: Bonuses.energyMax(),
    dashTime: 0,
    dashCooldown: 0,
    invuln: 0,
    shield: Bonuses.hasShield() ? 1 : 0,
    lives: Bonuses.hasExtraLife() ? 2 : 1
  };
}

// --- Спавн врагов по типам из конфига ---

function spawnEnemy(typeOverride) {
  const typeName = typeOverride || Utils.pickEnemyType(game.level);
  const cfg = CONFIG.enemyTypes[typeName] || CONFIG.enemyTypes.chaser;

  const edge = Math.floor(Math.random() * 4);
  let x, y;
  const pad = 40;
  if (edge === 0) { x = Math.random() * W; y = -pad; }
  else if (edge === 1) { x = W + pad; y = Math.random() * H; }
  else if (edge === 2) { x = Math.random() * W; y = H + pad; }
  else { x = -pad; y = Math.random() * H; }

  // radius в конфиге — диапазон [min, max]
  const radius = Array.isArray(cfg.radius)
    ? Utils.rand(cfg.radius[0], cfg.radius[1])
    : cfg.radius;

  // скорость = базовая * множитель типа * рост по уровню
  const baseSpeed = CONFIG.enemyBaseSpeed + (game.level - 1) * CONFIG.enemySpeedPerLevel;
  const speed = baseSpeed * (cfg.speedMul || 1);

  const enemy = {
    x: x,
    y: y,
    type: typeName,
    behavior: cfg.behavior || 'chase',
    radius: radius,
    color: cfg.color,
    hp: cfg.hp,
    maxHp: cfg.hp,
    speed: speed,
    score: cfg.score,
    shootTimer: cfg.shootInterval || 0,
    hitFlash: 0,
    angle: 0,
    // Для прямолинейных: направление полёта и параметры анимации
    dirX: 0,
    dirY: 0,
    wobble: cfg.wobble || 0,
    spin: cfg.spin || 0,
    phase: Math.random() * Math.PI * 2,
    spinAngle: 0
  };

  // Прямолинейные летят к противоположному краю карты
  if (enemy.behavior === 'straight') {
    const tx = W - x;
    const ty = H - y;
    const len = Math.hypot(tx, ty) || 1;
    enemy.dirX = tx / len;
    enemy.dirY = ty / len;
    enemy.angle = Math.atan2(enemy.dirY, enemy.dirX);
  }

  game.enemies.push(enemy);
  return enemy;
}

function spawnEnemyBullet(x, y, tx, ty, speed) {
  const dx = tx - x;
  const dy = ty - y;
  const len = Math.hypot(dx, dy) || 1;
  game.enemyBullets.push(new Bullet(
    x,
    y,
    (dx / len) * speed,
    (dy / len) * speed,
    1,
    {
      radius: CONFIG.bulletRadius,
      life: CONFIG.bulletLife,
      color: '#ff8a3d',
      glow: '#ff8a3d',
      coreColor: '#ffe0b0'
    }
  ));
}

// --- Попадание по врагу ---

function hitEnemy(enemy, damage) {
  enemy.hp -= damage;
  enemy.hitFlash = 0.12;

  if (enemy.hp > 0) {
    return false;
  }

  // Смерть врага
  const idx = game.enemies.indexOf(enemy);
  if (idx !== -1) game.enemies.splice(idx, 1);

  game.score += enemy.score;
  game.combo += 1;
  game.comboTimer = Bonuses.comboWindow();
  spawnBurst(enemy.x, enemy.y, enemy.color, 12);

  // Сплиттер делится на двух мелких
  const splitCfg = CONFIG.enemyTypes.splitter;
  if (enemy.type === 'splitter' && enemy.radius > 10) {
    const count = splitCfg.splitCount || 2;
    for (let i = 0; i < count; i++) {
      const child = {
        x: enemy.x + (Math.random() - 0.5) * 20,
        y: enemy.y + (Math.random() - 0.5) * 20,
        type: 'chaser',
        behavior: 'chase',
        radius: enemy.radius * 0.6,
        color: enemy.color,
        hp: 1,
        maxHp: 1,
        speed: enemy.speed * 1.35,
        score: Math.floor(enemy.score / 2),
        shootTimer: 0,
        hitFlash: 0,
        angle: 0,
        dirX: 0,
        dirY: 0,
        wobble: 0,
        spin: 0,
        phase: 0,
        spinAngle: 0
      };
      game.enemies.push(child);
    }
  }

  return true;
}

function spawnBurst(x, y, color, count) {
  for (let i = 0; i < count; i++) {
    const a = Math.random() * Math.PI * 2;
    const sp = 60 + Math.random() * 180;
    game.particles.push({
      x: x,
      y: y,
      vx: Math.cos(a) * sp,
      vy: Math.sin(a) * sp,
      life: 0.4 + Math.random() * 0.4,
      maxLife: 0.8,
      color: color,
      size: 2 + Math.random() * 3
    });
  }
}
